    {
      "name": "03 - List sections with pagination and course filter (Bai 4)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code la 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Loc dung ma hoc phan va phan trang CSDL\", () => {",
              "    const data = pm.response.json();",
              "    pm.expect(data).to.be.an(\"array\");",
              "    data.forEach(item => pm.expect(item.course_code).to.eql(\"INT2204\"));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/sections?course_code=INT2204&skip=0&limit=5",
          "host": ["{{base_url}}"],
          "path": ["sections"],
          "query": [
            { "key": "course_code", "value": "INT2204" },
            { "key": "skip", "value": "0" },
            { "key": "limit", "value": "5" }
          ]
        }
      }
